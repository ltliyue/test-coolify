# ── Database ──────────────────────────────────────────────
# 本地开发：PostgreSQL（localhost）
DATABASE_URL=postgresql+asyncpg://receptiviq:receptiviq@localhost:5432/receptiviq
SYNC_DATABASE_URL=postgresql+psycopg2://receptiviq:receptiviq@localhost:5432/receptiviq
# 线上生产：Neon Serverless Postgres（注意必须带 ?sslmode=require）
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# SYNC_DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production-32-chars-minimum
ENCRYPTION_KEY=Fernet-key-here-run-python-cryptography-to-generate
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Tenant Defaults ───────────────────────────────────────
DEFAULT_AGENCY_ID=00000000-0000-0000-0000-000000000001

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO (Object Storage) ────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receptiviq

# ── Snowflake (Data Warehouse) ────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=RECEPTIVIQ
SNOWFLAKE_WAREHOUSE=ETL_WH
SNOWFLAKE_SCHEMA=RAW
# Set to "duckdb" for local development (no Snowflake needed)
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/warehouse.duckdb

# ── Airflow ───────────────────────────────────────────────
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=

# ── AI / LLM ──────────────────────────────────────────────
OPENROUTER_API_KEY=
# Model routing (lightweight for classification, heavy for generation)
LLM_ROUTER_MODEL=anthropic/claude-haiku-4-5
LLM_PERSONA_MODEL=anthropic/claude-sonnet-4-6
LLM_CREATIVE_MODEL=anthropic/claude-sonnet-4-6
LLM_ATTRIBUTION_MODEL=anthropic/claude-haiku-4-5

# ── LLM Cost Management ───────────────────────────────────
# Per-tenant token budget (0 = unlimited)
DEFAULT_TOKEN_BUDGET_MONTHLY=0
TOKEN_CACHE_TTL_SECONDS=3600

# ── Langfuse (LLM Observability) ─────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# ── Sentry (Error Monitoring) ─────────────────────────────
SENTRY_DSN=

# ── Platform Integration OAuth Apps ──────────────────────
# GA4
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/ga4

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/meta

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/hubspot

# TikTok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/tiktok

# LeadRX
LEADRX_API_KEY=

# LiveRamp
LIVERAMP_CLIENT_ID=
LIVERAMP_CLIENT_SECRET=

# Canva
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Adobe Firefly
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=

# Icon.app / Adspy (Competitor Intelligence)
ICONAPP_API_KEY=

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
